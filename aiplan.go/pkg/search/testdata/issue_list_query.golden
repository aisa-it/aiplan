=== global/без_проекта/полнотекстовый_поиск
SQL:  SELECT issues.*, ts_headline('russian', issues.name, websearch_to_tsquery('russian', $1)) as name_highlighted, ts_headline('russian', issues.description_stripped, websearch_to_tsquery('russian', $2), 'MaxFragments=10, MaxWords=8, MinWords=3') as desc_highlighted, calc_rank(tokens, p.identifier, issues.sequence_id, $3) as ts_rank FROM issues join projects p on p.id = issues.project_id WHERE issues.project_id in (SELECT project_id FROM project_members WHERE member_id = $4) AND issues.workspace_id in (SELECT workspace_id FROM workspace_members WHERE member_id = $5) AND p.deleted_at IS NULL AND (issues.tokens @@ (websearch_to_tsquery('simple', normalize_fts_text($6)) || websearch_to_tsquery('russian', normalize_fts_text($7)) || websearch_to_tsquery('english', normalize_fts_text($8))) OR issues.tokens @@ (to_tsquery('simple', $9) || to_tsquery('russian', $10) || to_tsquery('english', $11)) OR issues.sequence_id::text like $12) AND (issues.draft = false or issues.draft is null) AND issues.deleted_at IS NULL ORDER BY ts_rank desc LIMIT $13
