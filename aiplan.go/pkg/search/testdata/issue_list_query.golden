=== проект/сортировка_по_статусу_desc
SQL:  SELECT issues.*, (SELECT concat(case "group" when 'backlog' then 1 when 'unstarted' then 2 when 'started' then 3 when 'completed' then 4 when 'cancelled' then 5 end, sequence, name, color) FROM states WHERE id = issues.state_id) as state_sort FROM issues WHERE issues.workspace_id = $1 AND issues.project_id = $2 AND (issues.draft = false or issues.draft is null) AND issues.deleted_at IS NULL ORDER BY state_sort DESC LIMIT $3
VARS: [22222222-2222-2222-2222-222222222222 33333333-3333-3333-3333-333333333333 0]

=== проект/сортировка_по_исполнителям
SQL:  SELECT issues.*, array(SELECT COALESCE(NULLIF(last_name,''), email) FROM users WHERE users.id in (SELECT assignee_id FROM issue_assignees WHERE issue_id = issues.id AND issue_assignees.deleted_at IS NULL) AND users.deleted_at IS NULL) as assignees_sort FROM issues WHERE issues.workspace_id = $1 AND issues.project_id = $2 AND (issues.draft = false or issues.draft is null) AND issues.deleted_at IS NULL ORDER BY assignees_sort LIMIT $3
VARS: [22222222-2222-2222-2222-222222222222 33333333-3333-3333-3333-333333333333 0]

